generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MeetingStatus {
  scheduled
  in_review
  decided
  analyzed
}

enum CompanyRole {
  owner
  admin
  member
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  avatarUrl String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CompanyMember[]
  meetings    Meeting[]

  @@map("users")
}

model Company {
  id         String   @id @default(uuid())
  name       String
  about      String   @default("")
  objectives String   @default("")
  culture    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members  CompanyMember[]
  meetings Meeting[]
  products CompanyProduct[]
  teams    CompanyTeam[]
  people   CompanyPerson[]

  @@map("companies")
}

model CompanyMember {
  id        String      @id @default(uuid())
  role      CompanyRole @default(owner)
  createdAt DateTime    @default(now())

  userId    String
  companyId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("company_members")
}

model Meeting {
  id           String        @id @default(uuid())
  title        String        @db.VarChar(120)
  date         DateTime      @db.Date
  time         String        @db.VarChar(5)
  participants String[]      @default([])
  status       MeetingStatus @default(scheduled)
  summary      String        @db.VarChar(500)
  owner        String        @db.VarChar(80)
  tags         String[]      @default([])
  signalCount  Int           @default(0)
  product      String?       @db.VarChar(80)
  description  String?       @db.VarChar(500)
  transcription String?      @db.Text
  notes        String?       @db.VarChar(1000)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  companyId String
  createdBy String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("meetings")
}

model CompanyProduct {
  id                String   @id @default(uuid())
  name              String   @db.VarChar(120)
  about             String   @db.VarChar(1000)
  solutionObjective String   @db.VarChar(1000)
  technology        String   @db.VarChar(500)
  targetAudience    String   @db.VarChar(500)
  averagePrice      String   @db.VarChar(120)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_products")
}

model CompanyTeam {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(120)
  about     String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groups  CompanyGroup[]
  people  CompanyPerson[]

  @@map("company_teams")
}

model CompanyGroup {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(120)
  about     String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId String

  team   CompanyTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  people CompanyPerson[]

  @@map("company_groups")
}

model CompanyPerson {
  id             String   @id @default(uuid())
  email          String   @db.VarChar(255)
  role           String?  @db.VarChar(120)
  reportsToEmail String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyId String
  teamId    String
  groupId   String?

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team    CompanyTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  group   CompanyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@map("company_people")
}
